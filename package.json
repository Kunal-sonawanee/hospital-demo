{
  "name": "kantex-hospital-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kantex Technologies — AI Receptionist & Appointment Automation demo for Uma Hospital, Nashik",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
